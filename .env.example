# Secrets for this site. Copy this file to ".env" and fill in your own values.
# .env is listed in .gitignore and blocked from the web by .htaccess, so it is never pushed or served.

# Google Gemini API key for "Generate with AI" on the announcement form and the Church Assistant (free tier).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq API key: the free backup AI, used when Gemini is out of its small daily free quota or too slow.
# Either key on its own is enough. Get one (free, no card) at https://console.groq.com/keys
GROQ_API_KEY=
